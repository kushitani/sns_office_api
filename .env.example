# 概要: 開発環境の設定例です。コピー後に秘密鍵を変更し、実際の.envはGitへ登録しないでください。
APP_ENV=development
DATABASE_URL=postgresql+psycopg://sns_office:sns_office@localhost:5432/sns_office
# Generate: python -c 'import secrets; print(secrets.token_urlsafe(48))'
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
CORS_ORIGINS=["http://localhost:5173"]
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
# Only used by the explicit seed command. Never seeded on application startup.
DEMO_EMAIL=demo@example.com
DEMO_PASSWORD=DemoPassword123!
